# Copy to .env and fill in. Never commit the real .env.

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site, used for payment return links (e.g. https://nexusply.com)
NEXT_PUBLIC_SITE_URL=

# SasPay (https://app.saspay.me). Server only.
SASPAY_SECRET_KEY=
SASPAY_WEBHOOK_SECRET=
SASPAY_COUNTRY=
# ADD_ON (customer pays fees) or DEDUCTED
SASPAY_FEE_CHARGE_MODE=ADD_ON

# Resend (https://resend.com) for payment receipts and support notifications. Server only.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Nexusply <notifications@nexusply.com>"
EMAIL_FROM=
# Optional reply-to for customer emails
EMAIL_REPLY_TO=
# Where new support messages are sent (comma-separated). Empty = every admin account.
SUPPORT_NOTIFY_EMAIL=
